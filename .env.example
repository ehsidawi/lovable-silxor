# Copy this file to `.env` and fill in your own values.
# Everything prefixed with VITE_ is bundled into the browser build.
# NEVER put private API keys, service-role keys, or SMTP passwords here.

# Lovable Cloud / Supabase (publishable, client-safe values only)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional: POST endpoint that receives assessment form submissions (JSON).
# Leave empty and the form transparently falls back to an email handoff.
VITE_LEAD_ENDPOINT=""

# Optional: privacy conscious analytics. Analytics stay fully disabled
# until VITE_ANALYTICS_ID is set. VITE_ANALYTICS_SRC is the script URL
# (e.g. https://plausible.io/js/script.js).
VITE_ANALYTICS_ID=""
VITE_ANALYTICS_SRC=""
